# systemd 单元(Linux VPS)
#   sudo cp deploy/refurb-sentry.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now refurb-sentry
#   journalctl -u refurb-sentry -f
[Unit]
Description=refurb-sentry - Apple 官方翻新产品监控
Documentation=https://github.com/hh-io/refurb-sentry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=refurb
Group=refurb
WorkingDirectory=/opt/refurb-sentry

# 密钥走环境变量文件,不进配置文件也不进日志。文件权限建议 0600。
# 用了 notify.daily_summary 而服务器系统时区不是你要的(云主机常是 UTC)时,
# 在同一个文件里加一行 TZ=Asia/Shanghai 即可——触发时刻按进程的 TZ 走。
EnvironmentFile=/etc/refurb-sentry/refurb-sentry.env
ExecStart=/opt/refurb-sentry/refurb-sentry -config /etc/refurb-sentry/config.yaml

# 由 systemd 创建并授权 /var/lib/refurb-sentry。
# 配置里的 state_path 请相应写成 /var/lib/refurb-sentry/state.json——
# 这比 ReadWritePaths 指向一个可能尚不存在的目录可靠:
# ProtectSystem=strict 下那种写法会在挂载命名空间阶段直接让单元起不来。
StateDirectory=refurb-sentry

# 进程退出后自动拉起;30 秒间隔避免配置写错时疯狂重启刷日志。
Restart=always
RestartSec=30

# SIGTERM 后程序需要落盘状态再退出,给足时间。
KillSignal=SIGTERM
TimeoutStopSec=30

# 日志走 stdout 交给 journald,轮转由系统的 journald.conf(SystemMaxUse 等)统一管理,
# 单元本身不必配置。查看:journalctl -u refurb-sentry -f
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
